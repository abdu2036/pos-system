/* تعريف خط Cairo المحلي للعمل أوفلاين */
@font-face {
    font-family: 'Cairo';
    src: url('../fonts/Cairo-Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
}

@font-face {
    font-family: 'Cairo';
    src: url('../fonts/Cairo-Bold.ttf') format('truetype');
    font-weight: 700;
    font-style: normal;
}

/* تطبيق الخط العربي على كافة عناصر المنظومة والجداول والأزرار */
body, h1, h2, h3, h4, h5, h6, input, button, select, textarea, .table, span, a {
    font-family: 'Cairo', sans-serif !important;
}